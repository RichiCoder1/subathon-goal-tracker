/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "subathon-goal-tracker",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-02-25",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"PARTY_HOST": "localhost:1999",
		"CALLBACK_OVERRIDE": "api.subathon-goal-tracker.local.richi.dev"
	},
	"env": {
		"production": {
			"routes": [
				{
					"pattern": "subathon.puplications.dev",
					"zone_name": "puplications.dev",
					"custom_domain": true
				}
			],
			"vars": {
				"PARTY_HOST": "api.richicoder1.partykit.dev",
        "TWITCH_CLIENT_ID": "v3b880spptl7hmajqrokqhvywiy8tn",
				"CALLBACK_OVERRIDE": ""
			},
			"observability": {
				"enabled": true,
				"traces": {
					"enabled": true
				},
				"logs": {
					"enabled": true
				}
			}
		}
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	}
}