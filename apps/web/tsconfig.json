{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "@cloudflare/workers-types/latest"
        ],
        "paths": {
            "#/layouts/*": [
                "src/layouts/*"
            ],
            "#/ui/*": [
                "src/components/ui/*"
            ],
            "#/components/*": [
                "src/components/*"
            ],
        },
        "plugins": [
            {
                "name": "@astrojs/ts-plugin"
            },
        ],
    }
}