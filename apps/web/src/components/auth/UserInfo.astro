---
import { Button } from '#/ui/Button';
import { getSession } from '../../auth/server';
import { env } from 'cloudflare:workers';
import { createAuthConfig } from '../../../auth.config';
import { LogOutIcon } from "lucide-react";

const session = await getSession(Astro.request, createAuthConfig(env));
---

<div class="flex gap-2 items-center">
  {session ? (
    <span>{session?.user?.name}</span>
    <img class="rounded" width="24" height="24" src={session?.user?.image} alt="" />
    <Button id="logout" variant="icon" aria-label="Sign out">
      <LogOutIcon />
    </Button>
  ) : null}
</div>

<script>
  const { authenticate } = await import('../../auth/client');
  document.getElementById("logout")?.addEventListener("click", () => {
    authenticate('signout').catch(() => window.alert('Could not sign out. Please try again.'));
  });
</script>
