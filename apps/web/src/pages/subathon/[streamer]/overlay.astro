---
import BareLayout from '../../../layouts/BareLayout.astro';
import { Overlay as OverlayPage } from "../../../components/subathon/Overlay";

import { env } from 'cloudflare:workers';
const streamer = Astro.params.streamer?.toLowerCase() ?? '';
if (!/^[a-z0-9_]{1,25}$/.test(streamer)) return new Response('Channel not found', {status:404});

export const prerender = false;
---

<BareLayout transparent>
    <OverlayPage client:load host={env.PARTY_HOST} room={streamer!}></OverlayPage>
</BareLayout>
